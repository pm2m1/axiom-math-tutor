# Copy to .env and fill in values as needed. Nothing here is required to run
# the current skeleton (see docs/roadmap.md for what each variable will
# eventually support).

# Runtime environment label, surfaced by GET /api/v1/status.
AXIOM_ENVIRONMENT=development

# Required only for the Phase 1I LLM evidence-judge evaluation
# (axiom.retrieval.evidence_judge). Not read by the running application.
GEMINI_API_KEY=

# Required only for --evaluator llm-judge-v3 --provider meta. Base URL
# defaults to https://api.meta.ai/v1 if unset; the adapter refuses to send
# the key to any other value.
MODEL_API_KEY=
MODEL_API_BASE_URL=

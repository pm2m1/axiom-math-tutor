# Copy to .env and fill in values as needed. Nothing here is required to run
# the current skeleton (see docs/roadmap.md for what each variable will
# eventually support).

# Runtime environment label, surfaced by GET /api/v1/status.
AXIOM_ENVIRONMENT=development

# Required only for the Phase 1I LLM evidence-judge evaluation
# (axiom.retrieval.evidence_judge). Not read by the running application.
GEMINI_API_KEY=

# Required for --evaluator llm-judge-v3 --provider meta (Phase 1I) and for
# the live POST /api/v1/question endpoint's evidence judge (Phase 1J),
# which both use the same MetaEvidenceJudge. Base URL defaults to
# https://api.meta.ai/v1 if unset; the adapter refuses to send the key to
# any other value.
MODEL_API_KEY=
MODEL_API_BASE_URL=

# Required for POST /api/v1/question's web-search fallback (Phase 1J),
# used only when the evidence judge finds the retrieved KB evidence
# insufficient. Sent as a Bearer token to Tavily's hosted MCP server.
TAVILY_API_KEY=
